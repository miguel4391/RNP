# Servidor
PORT=3000
NODE_ENV=development

# Segurança da API interna
API_KEY=alterar-para-uma-chave-segura

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=utilizador
DB_PASSWORD=palavra-passe
DB_NAME=area_pessoal
DB_CONNECTION_LIMIT=10

# Credenciais do Web Service RNP
RNP_URL=https://exemplo/rnp
RNP_USER_SECURITY=utilizador
RNP_USER_APLICACAO=APP01
RNP_TIMEOUT=30000

# Se o WS exigir SOAPAction, colocar aqui.
# Deixar vazio se não for necessário.
RNP_SOAP_ACTION=
